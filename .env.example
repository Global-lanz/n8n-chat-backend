# ============================================
# CONFIGURAÇÃO DO BACKEND - CHAT N8N
# ============================================

# ============================================
# BANCO DE DADOS
# ============================================

# URL de conexão do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:senha123@localhost:5432/chat_n8n

# ============================================
# SERVIDOR
# ============================================

# Porta onde o servidor irá rodar
PORT=3000

# ============================================
# SEGURANÇA
# ============================================

# Chave secreta para assinar os tokens JWT
# IMPORTANTE: Gere uma chave forte e única em produção!
# Você pode gerar uma usando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua-chave-secreta-muito-segura-e-longa-aqui-troque-isso

# ============================================
# ADMIN INICIAL (BOOTSTRAP VIA PRISMA)
# ============================================

# Se não existir nenhum administrador no banco, o backend cria automaticamente
# o primeiro admin no startup usando essas credenciais.
# IMPORTANTE: use valores fortes e altere após o primeiro login.
INITIAL_ADMIN_EMAIL=admin@exemplo.com
INITIAL_ADMIN_PASSWORD=troque-esta-senha-imediatamente
INITIAL_ADMIN_USERNAME=Admin

# ============================================
# CORS - Cross-Origin Resource Sharing
# ============================================

# Origens permitidas para fazer requisições ao backend
# Em desenvolvimento: use localhost
# Em produção: adicione seu domínio
# Múltiplas origens: separe por vírgula
# Para permitir qualquer origem (NÃO RECOMENDADO EM PRODUÇÃO): use *
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001,https://seu-dominio.com

# ============================================
# INTEGRAÇÃO N8N
# ============================================

# URL do webhook N8N para processar mensagens do chat
# Este webhook receberá as mensagens dos usuários e retornará respostas
N8N_WEBHOOK_URL=https://unnaove-madden-unrecorded.ngrok-free.dev/webhook/793dce42-bad4-4c1c-918f-b38cbfbb4e29/chat

# URL do webhook N8N para enviar emails de boas-vindas
# Este webhook será chamado quando um novo usuário for criado via Hotmart
# OPCIONAL: Comente esta linha se não quiser enviar emails
N8N_EMAIL_WEBHOOK_URL=https://seu-n8n.com/webhook/send-welcome-email

# ============================================
# CONFIGURAÇÕES OPCIONAIS
# ============================================

# Ambiente da aplicação (development, production, test)
NODE_ENV=development

# Tempo de expiração do token JWT (em segundos)
# 86400 = 24 horas, 604800 = 7 dias, 2592000 = 30 dias
# JWT_EXPIRATION=86400

# Número de rounds do bcrypt para hash de senhas (padrão: 10)
# Quanto maior, mais seguro, mas mais lento
# BCRYPT_ROUNDS=10

# ============================================
# LOGS E DEBUG
# ============================================

# Nível de log (error, warn, info, debug)
# LOG_LEVEL=info

# ============================================
# RATE LIMITING (Recomendado para produção)
# ============================================

# Limite de requisições por IP
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutos
# RATE_LIMIT_MAX_REQUESTS=100  # 100 requisições

# ============================================
# EXEMPLOS DE CONFIGURAÇÃO
# ============================================

# DESENVOLVIMENTO LOCAL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_dev
# PORT=3000
# ALLOWED_ORIGINS=http://localhost:8080
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat-message
# N8N_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/email
# NODE_ENV=development

# PRODUÇÃO:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/chat_prod
# PORT=3000
# ALLOWED_ORIGINS=https://chat.exemplo.com,https://www.exemplo.com
# N8N_WEBHOOK_URL=https://n8n.exemplo.com/webhook/chat-message
# N8N_EMAIL_WEBHOOK_URL=https://n8n.exemplo.com/webhook/email
# NODE_ENV=production
# JWT_SECRET=<gere-uma-chave-forte-de-64-caracteres>

# ============================================
# NOTAS IMPORTANTES
# ============================================

# 1. NUNCA commite este arquivo com valores reais no Git!
# 2. Use variáveis de ambiente do sistema em produção
# 3. Sempre use HTTPS em produção
# 4. Gere um JWT_SECRET único e forte
# 5. Configure rate limiting em produção
# 6. Use senhas fortes para o banco de dados
# 7. Mantenha backups regulares do banco de dados

# ============================================
# CHECKLIST DE SEGURANÇA
# ============================================

# [ ] JWT_SECRET foi alterado do padrão
# [ ] DATABASE_URL usa senha forte
# [ ] ALLOWED_ORIGINS está configurado corretamente
# [ ] HTTPS está habilitado em produção
# [ ] Firewall do banco de dados está configurado
# [ ] Backups automáticos estão configurados
# [ ] Rate limiting está habilitado
# [ ] Logs estão sendo monitorados
